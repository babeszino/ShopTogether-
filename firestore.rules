rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only signed-in (anonymous is fine) app users can touch a list.
    // The 8-character list code acts as the shared secret between you two.
    match /lists/{listCode}/items/{itemId} {
      allow read, write: if request.auth != null;
    }
  }
}
