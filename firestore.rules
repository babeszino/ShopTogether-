rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function listData(listId) {
      return get(/databases/$(database)/documents/lists/$(listId)).data;
    }
    function isMember(listId) {
      return signedIn() && request.auth.uid in listData(listId).members;
    }

    // A shopping list. Only its members can see it.
    match /lists/{listId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members == [request.auth.uid];

      allow update: if signedIn() && (
        // members can rename the list etc.
        request.auth.uid in resource.data.members
        // someone with a pending invite for their email can add THEMSELVES
        || (
          exists(/databases/$(database)/documents/invites/$(listId + '_' + myEmail()))
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames'])
        )
      );

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // Items on a list: members only.
    match /lists/{listId}/items/{itemId} {
      allow read, write: if isMember(listId);
    }

    // Invitations. The id is "<listId>_<invited email, lowercase>".
    match /invites/{inviteId} {
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && inviteId == request.resource.data.listId + '_' + request.resource.data.toEmail
        && isMember(request.resource.data.listId);

      allow read, update, delete: if signedIn()
        && (resource.data.toEmail == myEmail() || resource.data.fromUid == request.auth.uid);
    }
  }
}
